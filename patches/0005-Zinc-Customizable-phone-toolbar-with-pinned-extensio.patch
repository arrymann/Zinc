+
+    @Override
+    public void setExtensionsToolbarCoordinator(
+            @Nullable ExtensionsToolbarCoordinator extensionsToolbarCoordinator) {
+        mExtensionsToolbarCoordinator = extensionsToolbarCoordinator;
+        mExtensionsWidthConsumers.clear();
+        mExtensionsContainer = null;
+        if (extensionsToolbarCoordinator != null) {
+            mExtensionsContainer = findViewById(R.id.extensions_toolbar_container);
+            // Same priority order as the tablet toolbar (see ToolbarUtils): the popped-out action
+            // first, then the extensions menu button, then the pinned actions.
+            ToolbarWidthConsumer[] consumers = {
+                extensionsToolbarCoordinator.getPoppedOutActionWidthConsumer(),
+                extensionsToolbarCoordinator.getMenuButtonWidthConsumer(),
+                extensionsToolbarCoordinator.getRequestAccessButtonWidthConsumer(),
+                extensionsToolbarCoordinator.getActionListWidthConsumer()
+            };
+            for (ToolbarWidthConsumer consumer : consumers) {
+                mExtensionsWidthConsumers.add(consumer::updateVisibility);
+            }
+            extensionsToolbarCoordinator.updateMenuButtonBackground(mToolbarIconRippleId);
+        }
+        ViewUtils.requestLayout(this, "ToolbarPhone.setExtensionsToolbarCoordinator");
+    }
