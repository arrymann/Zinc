+    /** Zinc: called when the user changed the layout of the customizable buttons. */
+    private void onZincButtonsChanged() {
+        updateButtonVisibility();
+        ViewUtils.requestLayout(this, "ToolbarPhone.onZincButtonsChanged");
+    }
+
+    /**
+     * Zinc: offers the pinned extensions whatever width the address box can spare after the
+     * customizable buttons and the app menu. Extensions that do not fit overflow into the
+     * extensions menu instead of squeezing the address box.
+     */
+    private void allocateExtensionsWidth(int toolbarWidth) {
+        if (mExtensionsWidthConsumers.isEmpty()) return;
+        Resources res = getResources();
+        int reservedWidth = mZincButtons.getStartWidth() + mZincButtons.getEndWidth();
+        MenuButtonCoordinator menuButtonCoordinator = getMenuButtonCoordinator();
+        if (menuButtonCoordinator != null && menuButtonCoordinator.isVisible()) {
+            reservedWidth += res.getDimensionPixelSize(R.dimen.toolbar_button_width);
+        }
+        if (!mZincButtons.hasStartButtons()) reservedWidth += mToolbarSidePaddingForNtp;
+        int budget =
+                ZincToolbarWidthPlanner.extensionsBudget(
+                        toolbarWidth,
+                        reservedWidth,
+                        res.getDimensionPixelSize(R.dimen.zinc_min_location_bar_width));
+        ZincToolbarWidthPlanner.allocate(budget, mExtensionsWidthConsumers);
+    }
+
+    /** Draws a direct child of the end toolbar buttons container during texture capture. */
+    private void drawToolbarButtonsChild(Canvas canvas, View child) {
+        if (child.getVisibility() != VISIBLE || child.getWidth() == 0) return;
+        canvas.save();
+        ViewUtils.translateCanvasToView(mToolbarButtonsContainer, child, canvas);
+        child.draw(canvas);
+        canvas.restore();
+    }
+
+    /** Returns the Zinc views that fade out while the address box is focused. */
+    private List<View> getZincAnimatedViews() {
+        List<View> views = new ArrayList<>(3);
+        views.add(mZincButtons.getStartContainer());
+        views.add(mZincButtons.getEndContainer());
+        if (mExtensionsContainer != null) views.add(mExtensionsContainer);
+        return views;
+    }
