<!-- Settings preview of the Zinc toolbar. Slots are filled in code by
     ZincToolbarPreviewPreference. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/zinc_preview_horizontal_padding"
    android:paddingTop="16dp"
    android:paddingBottom="8dp"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/zinc_preview_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/zinc_preview_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:background="@drawable/zinc_preview_bar_background"
        android:importantForAccessibility="noHideDescendants">

        <LinearLayout
            android:id="@+id/zinc_preview_start"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/zinc_preview_address_box"
            android:layout_width="0dp"
            android:layout_height="@dimen/zinc_preview_address_box_height"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:background="@drawable/zinc_preview_address_box_background"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/zinc_settings_preview_address"
            android:textAppearance="@style/TextAppearance.TextMedium.Secondary" />

        <LinearLayout
            android:id="@+id/zinc_preview_end"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal" />

        <ImageView
            android:id="@+id/zinc_preview_extensions"
            android:layout_width="@dimen/zinc_preview_slot_width"
            android:layout_height="match_parent"
            android:scaleType="center"
            android:src="@drawable/zinc_ic_extensions"
            android:importantForAccessibility="no"
            app:tint="@color/default_icon_color_secondary_tint_list" />

        <ImageView
            android:id="@+id/zinc_preview_menu"
            android:layout_width="@dimen/zinc_preview_slot_width"
            android:layout_height="match_parent"
            android:scaleType="center"
            android:src="@drawable/zinc_ic_more_vert"
            android:importantForAccessibility="no"
            app:tint="@color/default_icon_color_tint_list" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/zinc_settings_preview_caption"
        android:textAppearance="@style/TextAppearance.TextSmall.Secondary"
        android:importantForAccessibility="no" />
</LinearLayout>
